{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "tools/**/*.mjs",
    "bench/scripts/*.mjs",
    "bench/scripts/pipeline/*.mjs",
    "bench/v4v5/**/*.mjs",
    "docs/lab/lab.js",
    "docs/lab/worker.js",
    "src/paint/techniques/passages/*.mjs",
    "src/media/gpu/batch-server.mjs",
    "src/media/gpu/web-brush.mjs"
  ],
  "project": [
    "src/**/*.mjs",
    "tools/**/*.mjs",
    "bench/**/*.mjs",
    "docs/lab/**/*.js"
  ],
  "ignore": [
    "bench/v2/kit/**",
    "bench/scripts/dry-painter.mjs"
  ],
  "ignoreIssues": {
    "src/media/sheet-size.mjs": [
      "duplicates"
    ],
    "docs/lab/media/**": [
      "exports"
    ],
    "docs/lab/media/sheet.js": [
      "exports",
      "unresolved"
    ]
  }
}
