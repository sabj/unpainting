{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/**/*.test.mjs",
    "tools/**/*.mjs",
    "bench/scripts/*.mjs",
    "bench/scripts/pipeline/*.mjs",
    "bench/v6/*.test.mjs",
    "bench/v4v5/**/*.mjs",
    "demos/lab/lab.js",
    "demos/lab/worker.js",
    "demos/lab/strokes/strokes.js",
    "demos/lab/strokes/bench-worker.js"
  ],
  "project": [
    "src/**/*.mjs",
    "tools/**/*.mjs",
    "bench/**/*.mjs",
    "demos/lab/**/*.js"
  ],
  "ignore": [
    "bench/v2/kit/**",
    "bench/scripts/dry-painter.mjs",
    "bench/v3/tips/**"
  ],
  "ignoreBinaries": [
    "codex",
    "ffmpeg",
    "sandbox-exec"
  ],
  "ignoreIssues": {
    "src/media/sheet-size.mjs": [
      "duplicates"
    ],
    "demos/lab/media/**": [
      "exports"
    ],
    "demos/lab/media/sheet.js": [
      "exports",
      "unresolved"
    ]
  }
}
